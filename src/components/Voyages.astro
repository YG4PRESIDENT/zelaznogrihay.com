---
import { getDestinations } from '../lib/voyages/content';
import { getStats, hasBeen } from '../lib/voyages/model';
import { journalContent } from '../lib/voyages/journal';
import { ATLAS_COLORS } from '../lib/voyages/rendering';
import '../styles/voyages.css';
const destinations = await getDestinations();
const stats = getStats(destinations);
const been = destinations.filter(destination => hasBeen(destination) && destination.kind === 'country');
const regions = (code: string) => destinations.filter(destination => hasBeen(destination) && destination.kind !== 'country' && been.find(country => country.countryCodes.some(countryCode => destination.countryCodes.includes(countryCode)))?.countryCodes[0] === code);
const ungrouped = destinations.filter(destination => hasBeen(destination) && destination.kind !== 'country' && !destination.countryCodes.some(code => been.some(country => country.countryCodes.includes(code))));
const wanted = destinations.filter(destination => destination.plans.length);
const payload = JSON.stringify({ destinations }).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<section class="voyages" id="voyages" aria-label="Travel map">
    <header class="voyages-heading"><h1>Voyages</h1><p>Where I've been. Where I'm heading.</p></header>
    <div class="voyages-stage" id="voyages-stage">
        <ul class="voyages-key" aria-label="Map key">
            <li><i style={`--swatch:${ATLAS_COLORS.visited}`} aria-hidden="true"></i>Been</li>
            <li><i style={`--swatch:${ATLAS_COLORS.wanted}`} aria-hidden="true"></i>Want to go</li>
            <li><i style={`--swatch:${ATLAS_COLORS.unvisited}`} aria-hidden="true"></i>Not yet</li>
        </ul>
        <div class="voyages-canvas" id="voyages-canvas" role="group" aria-label="Travel globe. All destinations are also available in the list."></div>
        <p class="voyages-map-status" id="voyages-map-status" role="status">Loading the globe…</p>
        <div class="voyages-map-caption"><span id="voyages-current">Drag to wander</span><button type="button" id="voyages-motion" data-map-action="motion" aria-pressed="true" hidden>Pause rotation</button>
            <div class="voyages-map-tools" id="voyages-map-tools" hidden aria-label="Globe controls"><button type="button" data-map-action="in" aria-label="Zoom in">+</button><button type="button" data-map-action="out" aria-label="Zoom out">−</button></div>
        </div>
    </div>
    <section class="voyages-explorer" id="voyages-explorer" aria-label="Places and travel plans">
        <div class="voyages-results" id="voyages-results">
            <section class="voyages-list-section"><h2>Where I've been <span>{stats.countries} countries</span></h2><div class="voyages-country-grid">
                {been.length ? been.map(destination => <details class="voyages-place" id={`destination-${destination.id}`} data-destination={destination.id}>
                    <summary><span class="voyages-place-name">{destination.name}</span>{destination.experience === 'passed-through' && <small>Passed through</small>}{destination.experience === 'lived' && <small>Lived here</small>}{!!destination.states?.length && <small>{destination.states.length} states</small>}{!!regions(destination.countryCodes[0]).length && <small>{regions(destination.countryCodes[0]).length} regions & places</small>}</summary>
                    <div class="voyages-inline-journal" set:html={journalContent(destination)} />
                    {regions(destination.countryCodes[0]).length > 0 && <section class="voyages-regions"><h3>Regions & places</h3>{regions(destination.countryCodes[0]).map(region => <details class="voyages-place voyages-region" id={`destination-${region.id}`} data-destination={region.id}><summary><span class="voyages-place-name">{region.name}</span></summary><div class="voyages-inline-journal" set:html={journalContent(region)} /></details>)}</section>}
                </details>) : <p class="voyages-empty">Past journeys will appear here as they're added.</p>}
            </div></section>
            {ungrouped.length > 0 && <section class="voyages-list-section"><h2>Regions & places</h2>{ungrouped.map(destination => <details class="voyages-place" id={`destination-${destination.id}`} data-destination={destination.id}><summary><span class="voyages-place-name">{destination.name}</span></summary><div class="voyages-inline-journal" set:html={journalContent(destination)} /></details>)}</section>}
            <section class="voyages-list-section voyages-wishlist"><h2>Where I'm heading</h2><div class="voyages-wish-grid">
                {wanted.map(destination => <details class="voyages-place" id={hasBeen(destination) ? `wish-${destination.id}` : `destination-${destination.id}`} data-destination={destination.id}>
                    <summary><span class="voyages-place-name">{destination.plans.map(plan => plan.title).join(' · ')}</span></summary>
                    <div class="voyages-inline-journal" set:html={journalContent(destination)} />
                </details>)}
            </div></section>
        </div>
    </section>
    <p class="voyages-sr-only" id="voyages-live" aria-live="polite" aria-atomic="true"></p>
    <dialog class="voyages-lightbox" id="voyages-lightbox" aria-labelledby="voyages-photo-title">
        <div class="voyages-lightbox-bar"><h2 id="voyages-photo-title"></h2><span id="voyages-photo-count"></span><button type="button" id="voyages-photo-close" aria-label="Close photo">×</button></div>
        <div class="voyages-lightbox-stage"><button type="button" id="voyages-photo-prev" aria-label="Previous photo">←</button><img id="voyages-photo-image" alt="" /><button type="button" id="voyages-photo-next" aria-label="Next photo">→</button><p id="voyages-photo-error" hidden>This photo could not be loaded.</p></div>
        <p class="voyages-photo-caption" id="voyages-photo-caption" aria-live="polite"></p>
    </dialog>
    <script type="application/json" id="voyages-data" set:html={payload}></script>
    <noscript><style is:inline>#voyages{display:block;height:auto;min-height:0}#voyages .voyages-map-status,#voyages .voyages-stage{display:none}#voyages .voyages-heading,#voyages .voyages-explorer{position:relative;inset:auto;width:auto;max-height:none;overflow:visible;padding:24px}#voyages .voyages-heading{padding-bottom:0}</style></noscript>
</section>
<script>import { initVoyages } from '../lib/voyages/client'; initVoyages();</script>
