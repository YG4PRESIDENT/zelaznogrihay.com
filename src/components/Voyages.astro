---
import { countries, getDestinations } from '../lib/voyages/content';
import { getStats, hasBeen } from '../lib/voyages/model';
import { journalContent } from '../lib/voyages/journal';
import '../styles/voyages.css';
const destinations = await getDestinations();
const stats = getStats(destinations);
const been = destinations.filter(hasBeen);
const wanted = destinations.filter(destination => destination.plans.length);
const payload = JSON.stringify({ destinations, countries }).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
---
<section class="voyages" id="voyages" aria-label="Travel map">
    <header class="voyages-heading"><h1>Voyages</h1><p>Where I've been. Where I'm heading.</p></header>
    <div class="voyages-stage" id="voyages-stage">
        <div class="voyages-canvas" id="voyages-canvas" role="group" aria-label="Travel globe. All destinations are also available in the list."></div>
        <p class="voyages-map-status" id="voyages-map-status" role="status">Loading the globe…</p>
        <div class="voyages-map-tools" id="voyages-map-tools" hidden aria-label="Globe controls"><button type="button" data-map-action="in" aria-label="Zoom in">+</button><button type="button" data-map-action="out" aria-label="Zoom out">−</button></div>
    </div>
    <aside class="voyages-explorer" id="voyages-explorer" aria-label="Places and travel plans">
        <div class="voyages-results" id="voyages-results">
            <section class="voyages-list-section"><h2>Countries <span>{stats.countries}</span></h2>
                {been.length ? been.map(destination => <details class="voyages-place" id={`destination-${destination.id}`} data-destination={destination.id}>
                    <summary><span class="voyages-place-name">{destination.name}</span>{destination.experience === 'passed-through' && <small>Passed through</small>}{destination.experience === 'lived' && <small>Lived here</small>}</summary>
                    <div class="voyages-inline-journal" set:html={journalContent(destination)} />
                </details>) : <p class="voyages-empty">Past journeys will appear here as they're added.</p>}
            </section>
            <section class="voyages-list-section voyages-wishlist"><h2>Want to go</h2>
                {wanted.map(destination => <details class="voyages-place" id={hasBeen(destination) ? `wish-${destination.id}` : `destination-${destination.id}`} data-destination={destination.id}>
                    <summary><span class="voyages-place-name">{destination.plans.map(plan => plan.title).join(' · ')}</span></summary>
                    <div class="voyages-inline-journal" set:html={journalContent(destination)} />
                </details>)}
            </section>
        </div>
    </aside>
    <p class="voyages-sr-only" id="voyages-live" aria-live="polite" aria-atomic="true"></p>
    <dialog class="voyages-lightbox" id="voyages-lightbox" aria-labelledby="voyages-photo-title">
        <div class="voyages-lightbox-bar"><h2 id="voyages-photo-title"></h2><span id="voyages-photo-count"></span><button type="button" id="voyages-photo-close" aria-label="Close photo">×</button></div>
        <div class="voyages-lightbox-stage"><button type="button" id="voyages-photo-prev" aria-label="Previous photo">←</button><img id="voyages-photo-image" alt="" /><button type="button" id="voyages-photo-next" aria-label="Next photo">→</button><p id="voyages-photo-error" hidden>This photo could not be loaded.</p></div>
        <p class="voyages-photo-caption" id="voyages-photo-caption" aria-live="polite"></p>
    </dialog>
    <script type="application/json" id="voyages-data" set:html={payload}></script>
    <noscript><style is:inline>#voyages .voyages-map-status,#voyages .voyages-stage{display:none}#voyages .voyages-heading,#voyages .voyages-explorer{position:relative;inset:auto;width:auto;max-height:none;padding:24px}#voyages .voyages-heading{padding-bottom:0}</style></noscript>
</section>
<script>import { initVoyages } from '../lib/voyages/client'; initVoyages();</script>
